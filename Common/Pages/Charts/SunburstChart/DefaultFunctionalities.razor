@page "/sunburst-chart/default-functionalities"

@using Syncfusion.Blazor
@*Hidden:Lines*@
@using ThemeHelper
@*End:Hidden*@
@using Syncfusion.Blazor.Charts

@inject NavigationManager NavigationManager
@*Hidden:Lines*@
@inherits SampleBaseComponent
@*End:Hidden*@

<ActionDescription>
    <p>This Blazor Sunburst Chart example visualizes the top universities from the QS World University Rankings 2026, grouped by region and country.</p>

    <p>In this example, you can see how to render and configure a sunburst chart. The sunburst chart is ideal for displaying hierarchical data where each ring represents a level in the hierarchy. Key features demonstrated here include:</p>
    <ul>
        <li><code>Title</code> and <code>SubTitle</code> to provide a heading and source for the chart</li>
        <li><code>Radius</code> set to <code>0.9</code> to give the chart a slightly inset frame inside the available area</li>
        <li><code>SunburstDataLabelSettings</code> with <code>LabelRotationMode</code> set to <code>Angle</code> and <code>LabelOverflowMode</code> set to <code>Trim</code> to keep labels readable along the radial layout</li>
        <li><code>SunburstTooltipSettings</code> with <code>EnableHighlight</code> set to <code>true</code> to show the value and category of a segment on hover and emphasize the hovered segment</li>
        <li>A custom <code>Palette</code> aligned to the active theme to color the rings consistently</li>
    </ul>

    <p><code>Tooltip</code> is enabled in this example. To see tooltip details, hover over or tap on a segment.</p>

    <p>More information about the sunburst chart can be found in this <a target='_blank' href='https://blazor.syncfusion.com/documentation/sunburst-chart/getting-started' aria-label="Navigate to the documentation for sunburst chart component" rel='noopener'>documentation section</a>.</p>
</ActionDescription>

<div class="control-section" align='center'>
    <SfSunburstChart TItem="NodeDetails"
                     DataSource="@data"
                     Palette="@Palette"
                     IdMemberPath="@nameof(NodeDetails.Id)"
                     ParentIdMemberPath="@nameof(NodeDetails.ParentId)"
                     LabelMemberPath="@nameof(NodeDetails.Name)"
                     ValueMemberPath="@nameof(NodeDetails.Value)"
                     InnerRadius="0.25"
                     StartAngle="0"
                     EndAngle="360"
                     Radius="@Radius"
                     EnableAnimation="true"
                     AnimationType="SunburstAnimationType.FadeIn"
                     Title="World University Rankings 2026"
                     Subtitle="Source: topuniversities.com"
                     ID="SunburstChart"
                     Theme="@Theme"
                     Width="@Width"
                     Height="@Height">
        <SunburstTitleSettings FontWeight="600" Size="16px" />
        <SunburstSubtitleSettings FontWeight="400" Size="12px" />
        <SunburstDataLabelSettings Visible="true"
                                   RotationMode="SunburstLabelRotationMode.Angle">
            <SunburstDataLabelTextStyle FontWeight="500" />
        </SunburstDataLabelSettings>
        <SunburstTooltipSettings Enable="true"
                                 EnableHighlight="true"
                                 HeaderText="QS Overall Score"
                                 Format="${point.label}<br/>Score: ${point.value}" />
    </SfSunburstChart>
</div>

@code
{
    private Theme Theme { get; set; }
    public string Width { get; set; } = "90%";
    public string Height { get; set; } = "600px";
    public double Radius { get; set; } = 0.9;
    public string FontFamily { get; set; } = "Roboto";

    private string[] Palette = Array.Empty<string>();

    protected override void OnInitialized()
    {
        Theme = ThemeHelper.GetCurrentTheme(NavigationManager.Uri);
        FontFamily = ThemeHelper.GetFontFamily(NavigationManager.Uri);
        Palette = SunburstThemeColors.GetDefaultPalette(Theme);

        @*Hidden:Lines*@
        if (SampleService != null && SampleService.IsDevice)
