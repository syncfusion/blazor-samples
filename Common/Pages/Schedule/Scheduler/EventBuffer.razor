@page "/scheduler/event-buffer"
@using System.Security.Cryptography
@using Syncfusion.Blazor.Schedule
@using Syncfusion.Blazor.Popups

@*Hidden:Lines*@
@inherits SampleBaseComponent
@*End:Hidden*@

<ActionDescription>
    <p>
        This surgery scheduling demo highlights efficient operating room management using configurable pre-procedure and post-procedure buffer times within the Scheduler.
        Plan surgeries with dedicated preparation and recovery periods, reduce scheduling overlaps, maximize operating room utilization, and streamline healthcare appointment coordination.
    </p>
    <p>
        The <code>EnableBuffer</code> property of <code>EventSettings</code> activates the buffer feature. The
        <code>BufferBefore</code> and <code>BufferAfter</code> field mappings (in minutes) are configured through
        <code>EventSettings.Fields</code>, while a custom <code>BufferTemplate</code> displays an icon and the
        corresponding buffer duration within the buffer element.
    </p>
    <p>
        With <code>AllowOverlap="false"</code>, conflict detection considers both the appointment duration and its
        associated buffer periods, helping prevent scheduling collisions. Additionally, drag-and-drop operations can
        be restricted to operating rooms that match the specialty required for a surgery.
    </p>
    <p>
        Buffer rendering and interaction are supported in the following Scheduler views:
    </p>
    <ul>
        <li><strong>Day</strong></li>
        <li><strong>Week</strong></li>
        <li><strong>WorkWeek</strong></li>
        <li><strong>TimelineDay</strong></li>
        <li><strong>TimelineWeek</strong></li>
        <li><strong>TimelineWorkWeek</strong></li>
    </ul>
    <p>
        During drag and resize actions, buffer segments automatically re-anchor to the event boundaries, providing an
        accurate preview of the reserved preparation and recovery time.
    </p>
    <p>
        Looking for the full Blazor Scheduler component overview, features, pricing, and documentation? Visit our
        <a rel="noopener" target="_blank" href="https://www.syncfusion.com/scheduler-sdk/blazor-scheduler"
           aria-label="Navigate to the Blazor Scheduler component page">
            Blazor Scheduler
        </a>
        component page.
    </p>
</ActionDescription>

<SfDialog Width="320px"
          IsModal="true"
          @bind-Visible="ShowDialog">

    <DialogTemplates>
        <Header>Alert</Header>

        <Content>
            Events cannot be scheduled in this operating room because it does not
            match the required specialty.
        </Content>
    </DialogTemplates>

    <DialogButtons>
        <DialogButton Content="OK"
                      IsPrimary="true"
                      OnClick="CloseDialog">
        </DialogButton>
    </DialogButtons>

</SfDialog>

<div class="control-section">
    <SfSchedule TValue="AppointmentData"
                @ref="ScheduleRef"
                CssClass="medical-scheduler"
                Width="100%"
                Height="650px"
                @bind-CurrentView="@CurrentView"
                @bind-SelectedDate="@SelectedDate" AllowOverlap="false">

        <ScheduleGroup Resources="@ResourceNames">
        </ScheduleGroup>

        <ScheduleTimeScale Interval="60"
                           SlotCount="4">
        </ScheduleTimeScale>

        <ScheduleViews>

            <ScheduleView Option="View.Day">
            </ScheduleView>

            <ScheduleView Option="View.TimelineDay">
            </ScheduleView>

            <ScheduleView Option="View.TimelineWeek">
            </ScheduleView>

        </ScheduleViews>

        <ScheduleResources>

            <ScheduleResource TValue="int"
                              TItem="RoomData"
                              Name="Rooms"
                              Field="RoomId"
                              Title="Operating Room"
                              DataSource="@Rooms"
                              TextField="RoomText"
                              IdField="RoomId"
                              ColorField="RoomColor">
            </ScheduleResource>

        </ScheduleResources>

        <ScheduleTemplates>

            <ResourceHeaderTemplate>

                @{
                    var room = (context as TemplateContext).ResourceData as RoomData;
                }

                @if (room != null)
                {
                    <div class="medical-resource">

                        <div class="medical-resource-icon">
                            @room.Icon
                        </div>

                        <div class="medical-resource-content">

                            <div class="medical-resource-specialty">
                                @room.Specialty
                            </div>

                        </div>

                    </div>
                }

            </ResourceHeaderTemplate>

            <HeaderIndentTemplate>
                @if (CurrentView != View.Day)
                {

                    <div class="resource-header-title">

                        <div class="resource-header-main">
                            Operating Rooms
                        </div>

                        <div class="resource-header-sub">
                            Surgery Suites
                        </div>

                    </div>
                }

            </HeaderIndentTemplate>

        </ScheduleTemplates>

        <ScheduleEvents TValue="AppointmentData"
                        Dragged="OnDragStop"
                        OnActionBegin="OnActionBegin">
        </ScheduleEvents>

        <ScheduleEventSettings TValue="AppointmentData"
                               DataSource="@Appointments"
                               EnableBuffer="true">

            <BufferTemplate>
                @{
                    var ctx = context as BufferTemplateContext<AppointmentData>;
                }

                @if (ctx != null)
                {
                    var icon = ctx.IsBefore
                    ? "https://ej2.syncfusion.com/demos/src/schedule/images/health-day.svg"
                    : "https://ej2.syncfusion.com/demos/src/schedule/images/cancer-day.svg";

                    if (ctx.Duration >= 10)
                    {
                        if (CurrentView == View.Day)
                        {
                            if (ctx.Duration > 15)
                            {
                                <div class="buffer-minimal">
                                    <img class="buffer-svg-icon" src="@icon" alt="" />
                                    <span class="buffer-duration">
                                        @ctx.Duration min
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="buffer-duration">
                                    @ctx.Duration min
                                </span>
                            }
                        }
                        else
                        {
                            <div class="buffer-minimal">
                                <img class="buffer-svg-icon" src="@icon" alt="" />

                                @if (ctx.Duration > 20)
                                {
                                    <span class="buffer-duration">
                                        @ctx.Duration min
                                    </span>
                                }
                            </div>
                        }
                    }
                }
            </BufferTemplate>

        </ScheduleEventSettings>

    </SfSchedule>

</div>

@code {

    private SfSchedule<AppointmentData>? ScheduleRef;

    private bool ShowDialog;

    private DateTime SelectedDate = DateTime.Today;
    private View CurrentView = View.TimelineDay;

    private string[] ResourceNames = { "Rooms" };

    private List<AppointmentData> Appointments = new();

    private Dictionary<string, List<string>> Subjects = new()
    {
        { "Cardiology", new() { "Cardiac Workup", "Heart Valve Assessment", "Stress Test", "ECG Review" } },
        { "Orthopedics", new() { "Knee Replacement", "Bone Fracture Assessment", "Spinal Workup" } },
        { "Neurology", new() { "Neurology Workup", "Brain MRI Review" } },
        { "Pediatrics", new() { "Child Wellness Review", "Immunization Follow-up" } },
        { "Emergency", new() { "Emergency Care", "Acute Care", "Trauma Care", "Critical Care" } },
        { "Radiology", new() { "CT Scan Analysis", "MRI Scan Review" } }
    };

    private List<RoomData> Rooms = new()
    {
        new() { RoomId = 1, RoomText = "Cardiac Surgery Suite", Specialty = "Cardiology", RoomColor = "#ef4444", Icon = "❤️" },
        new() { RoomId = 2, RoomText = "Orthopedic Center", Specialty = "Orthopedics", RoomColor = "#2563eb", Icon = "🦴" },
        new() { RoomId = 3, RoomText = "Neuroscience Unit", Specialty = "Neurology", RoomColor = "#8b5cf6", Icon = "🧠" },
        new() { RoomId = 4, RoomText = "Pediatric Care Suite", Specialty = "Pediatrics", RoomColor = "#10b981", Icon = "👶" },
        new() { RoomId = 5, RoomText = "Emergency Trauma Bay", Specialty = "Emergency", RoomColor = "#f97316", Icon = "🚑" },
        new() { RoomId = 6, RoomText = "Diagnostic Imaging Center", Specialty = "Radiology", RoomColor = "#0ea5e9", Icon = "🔬" }
    };

    protected override void OnInitialized()
    {
        Appointments = GenerateAllEvents(SelectedDate);
    }

    private List<AppointmentData> GenerateAllEvents(DateTime date)
    {
        return GenerateEvents(date.AddDays(-1))
            .Concat(GenerateEvents(date))
            .Concat(GenerateEvents(date.AddDays(1)))
            .ToList();
    }

    private List<AppointmentData> GenerateEvents(DateTime date)
    {
        List<AppointmentData> result = new();

        int id = date.Day * 100;

        foreach (var room in Rooms)
        {
            result.Add(CreateEvent(room, date, 9, 15, id++));

            result.Add(CreateEvent(room, date, 13, 30, id++));
        }

        return result;
    }

    private AppointmentData CreateEvent(
        RoomData room,
        DateTime date,
        int hour,
        int minute,
        int id)
    {
        int[] buffers = { 30, 45, 60 };

        var start = new DateTime(
            date.Year,
            date.Month,
            date.Day,
            hour,
            minute,
            0);

        int duration =
            RandomNumberGenerator.GetInt32(2) == 0
            ? 75
            : 90;

        return new AppointmentData
        {
            Id = id,
            Subject = Subjects[room.Specialty!]
                [RandomNumberGenerator.GetInt32(Subjects[room.Specialty!].Count)],

            StartTime = start,
            EndTime = start.AddMinutes(duration),

            RoomId = room.RoomId,
            RequiredSkill = room.Specialty,

            BufferBefore = buffers[RandomNumberGenerator.GetInt32(3)],
            BufferAfter = buffers[RandomNumberGenerator.GetInt32(3)]
        };
    }

    private Task OnDragStop(DragEventArgs<AppointmentData> args)
    {
        var room = Rooms.FirstOrDefault(x =>
            x.RoomId == args.Data.RoomId);

        if (room != null &&
            room.Specialty != args.Data.RequiredSkill)
        {
            args.Cancel = true;
            ShowDialog = true;
        }

        return Task.CompletedTask;
    }

    private void OnActionBegin(ActionEventArgs<AppointmentData> args)
    {
        if (args.ActionType == ActionType.EventCreate)
        {
            foreach (var record in args.AddedRecords)
            {
                var room = Rooms.FirstOrDefault(x =>
                    x.RoomId == record.RoomId);

                if (room != null)
                {
                    record.RequiredSkill = room.Specialty;
                }
            }
        }
    }

    private void CloseDialog(object args)
    {
        ShowDialog = false;
    }

    public class RoomData
    {
        public int RoomId { get; set; }

        public string? RoomText { get; set; }

        public string? Specialty { get; set; }

        public string? RoomColor { get; set; }

        public string? Icon { get; set; }
    }

    public class AppointmentData
    {
        public int Id { get; set; }

        public string? Subject { get; set; }

        public DateTime StartTime { get; set; }

        public DateTime EndTime { get; set; }

        public int RoomId { get; set; }

        public string? RequiredSkill { get; set; }

        public int BufferBefore { get; set; }

        public int BufferAfter { get; set; }
    }

}
<style>
    .medical-resource {
        display: flex;
        align-items: center;
        height: 50px;
        gap: 16px;
        padding-left: 16px;
        box-sizing: border-box;
    }

    .medical-scheduler.e-schedule .e-timeline-view .e-work-cells {
        height: 80px !important;
    }

    .medical-scheduler.e-schedule .e-resource-cells {
        height: 70px !important;
    }

    .medical-scheduler.e-schedule .e-buffer-app {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .medical-scheduler.e-schedule img {
        height: 35px;
        width: 35px;
    }

    /* Buffer pill (before/after) */
    .buffer-minimal {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 6px;
        overflow: hidden;
    }

    .e-day-wrapper .buffer-minimal {
        width: 100%;
        height: 100%;
        display: grid;
        justify-content: center;
        align-items: center;
        gap: 6px;
        overflow: hidden;
    }

    .buffer-svg-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .medical-scheduler .e-buffer-app img {
        max-width: 18px;
        max-height: 18px;
    }

    .buffer-duration {
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* Small buffers: keep only the icon visible, but allow ellipsis on the duration */
    .buffer-minimal .buffer-duration {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .buffer-info {
        min-width: 0;
        overflow: hidden;
    }

    /* Resource header (left panel) */
    .medical-resource-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }

    .medical-resource-content {
        min-width: 0;
    }

    .medical-resource-name {
        font-size: 13px;
        font-weight: 600;
        line-height: 18px;
    }

    .medical-resource-specialty {
        font-size: 11px;
        line-height: 16px;
    }

    /* Empty header (top-left) */
    .resource-header-title {
        padding: 12px 16px;
    }

    .resource-header-main {
        font-size: 15px;
        font-weight: 600;
    }

    .resource-header-sub {
        margin-top: 2px;
        font-size: 11px;
    }
</style>