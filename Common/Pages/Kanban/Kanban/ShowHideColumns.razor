@code{
    private IReadOnlyCollection<KanbanDataModel> CardData = KanbanDataModel.GetMenuDevelopment();
    private List<ColumnModel> ColumnData = new List<ColumnModel>()
    {
        new ColumnModel() { HeaderText = "Concept", KeyField = new List<string>() { "Concept" }, Visible = true },
        new ColumnModel() { HeaderText = "Recipe Test", KeyField = new List<string>() { "Recipe Test" }, Visible = true },
        new ColumnModel() { HeaderText = "Photography", KeyField = new List<string>() { "Photography" }, Visible = true },
