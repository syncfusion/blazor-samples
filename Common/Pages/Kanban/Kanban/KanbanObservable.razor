@page "/kanban/observable"
@using Syncfusion.Blazor.Kanban
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications
@using System.Collections.ObjectModel;
@using System.ComponentModel;
@using System.Security.Cryptography
@*Hidden:Lines*@
@inherits SampleBaseComponent;
@*End:Hidden*@

<ActionDescription>
<p>
    This sample demonstrates data binding with <code>ObservableCollection</code> in the <a class="e-kanban-observable-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component"
                                                                                                                              href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board"
                                                                                                                              target="_blank" rel="noopener">Blazor Kanban</a> component by visualizing a software development task tracker. The board reflects real-time changes when cards are added, removed, or updated through the action buttons.
</p>
<p>
    When using <code>ObservableCollection</code>, the Kanban UI updates automatically as items are added or removed from the data source. For property-level updates, implement <code>INotifyPropertyChanged</code> on the data model to refresh UI on value changes.
</p>
<p>
    Additional essential interactions that enhance analysis and control are also featured:
</p>
<ul>
    <li>
        <a aria-label="Navigate to the documentation for data binding in kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/data-binding"
           target="_blank" rel="noopener">Data Binding</a>: Bind an <code>ObservableCollection</code> to the Kanban <code>DataSource</code> property to enable live updates.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for dialog editing in kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/dialog"
           target="_blank" rel="noopener">Dialog Editing</a>: Add and edit cards through the card editor dialog driven by the observable collection.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for columns in kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/columns"
           target="_blank" rel="noopener">Columns</a>: Group cards by workflow stage such as To Do, In Progress, Testing, and Done.
    </li>
</ul>
<p>
    Key interactive features demonstrated in this sample include:
</p>
<ul>
    <li><b>Add Card</b>: Click the Add Card button to insert a new task into the observable collection. The board updates immediately.</li>
    <li><b>Delete Card</b>: Click the Delete Card button to remove a task. The board reflects the change without a page reload.</li>
    <li><b>Update Card</b>: Click the Update Card button to modify a task property. The board updates in real time.</li>
    <li><b>Toast Notification</b>: A toast message confirms each action so the user knows the change was applied.</li>
</ul>
<p>
    The <b>Data Configuration</b> highlights the building blocks of observable data binding:
</p>
<ul>
    <li><b>ObservableCollection</b>: The data source is an <code>ObservableCollection</code> that fires change notifications.</li>
    <li><b>INotifyPropertyChanged</b>: The data model implements <code>INotifyPropertyChanged</code> to notify on property updates.</li>
    <li><b>Action Buttons</b>: The Add, Delete, and Update actions mutate the collection and surface a confirmation toast.</li>
</ul>
<p>
Looking for the full Blazor Kanban component overview, features, pricing, and documentation? Visit the <a class="e-kanban-observable-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component" href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board" target="_blank" rel="noopener">Blazor Kanban</a> page.</p>
</ActionDescription>


<div class="col-lg-12 control-section">
    <div class="content-wrapper" id="toast-kanban-observable">
        <div class="row">
            <div class="btn" style="margin: 0 0 7px 7px;">
                <SfButton @onclick="AddRecord">Add Card</SfButton>
                <SfButton @onclick="DeleteRecord">Delete Card</SfButton>
                <SfButton @onclick="UpdateRecord">Update Card</SfButton>
            </div>
            <SfKanban KeyField="Status" DataSource="@TasksCollection" Height="500px">
                <KanbanColumns>
                    @foreach (ColumnModel item in ColumnData)
                    {
                        <KanbanColumn HeaderText="@item.HeaderText" KeyField="@item.KeyField" AllowAdding="true"/>
                    }
                </KanbanColumns>
                <KanbanCardSettings HeaderField="Id" ContentField="Summary">
    <Template>
        @{
            KanbanTask card = (KanbanTask)context;
            <div class="min-card" style="--color: #5C6BC0;">
                <div class="mc-strip"></div>
                <div class="mc-content">
                    <div class="mc-head">
                        <span class="mc-type">Task</span>
                    </div>
                    <h3 class="mc-title">@card.Id</h3>
                    <p class="mc-desc">@card.Summary</p>
                    <div class="mc-footer">
                        <span class="mc-priority" data-p="Normal">@card.Assignee</span>
                        <span class="mc-id">@card.Status</span>
                    </div>
                </div>
            </div>
        }
    </Template>
</KanbanCardSettings>

            </SfKanban>
            <SfToast @ref="ToastObj" ID="toast_type" Content="@ToastContent" Timeout=2000 Target="@ToastTarget">
                <ToastPosition X="Right" Y="Top"/>
            </SfToast>
        </div>
    </div>
</div>
<style>
    .min-card { display: flex; border-radius: 8px; overflow: hidden; 
                box-shadow: 0 2px 8px rgba(0,0,0,.08); 
                transition: all .3s cubic-bezier(.25,.46,.45,.94); border: 1px solid #f0f0f0; }
    .min-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.12); transform: translateY(-3px); 
                      border-color: var(--color); }
    .mc-strip { width: 5px; background: linear-gradient(180deg, var(--color) 0%, rgba(0,0,0,.1) 100%); flex-shrink: 0; }
    .mc-content { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .mc-head { display: flex; justify-content: space-between; align-items: center; line-height: normal; padding: 7px;  }
    .mc-type { font-size: 10px; font-weight: 700; background: rgba(0,0,0,.05); 
               padding: 2px 6px; border-radius: 3px; border-left: 3px solid var(--color); text-transform: uppercase; }
    .mc-avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--color); 
                 color: #fff; display: flex; align-items: center; justify-content: center; 
                 font-size: 9px; font-weight: 700; box-shadow: 0 2px 6px rgba(0,0,0,.15); 
                 transition: transform .2s; }
    .min-card:hover .mc-avatar { transform: scale(1.12); }
    .mc-title { padding-left: 5px; font-size: 13px; font-weight: 700;  margin: 0; line-height: 1.3; }
    .mc-desc { padding: 5px; font-size: 11px; margin: 0; line-height: 1.4; }
    .mc-footer { display: flex; justify-content: space-between; font-size: 10px; 
                 padding: 8px; border-top: 1px dashed #e5e5e5; font-weight: 600; line-height: normal; padding: 7px;  }
    .mc-priority { padding: 2px 6px; border-radius: 3px; background: #ececec; color: #6b6b6b; }
</style>
@code{
    private SfToast? ToastObj;

    private List<ColumnModel> ColumnData = new List<ColumnModel>() 
    {
        new ColumnModel(){ HeaderText= "To Do", KeyField= new List<string>() { "Open" } },
        new ColumnModel(){ HeaderText= "In Progress", KeyField= new List<string>() { "In Progress" } },
        new ColumnModel(){ HeaderText= "Testing", KeyField= new List<string>() { "Testing" } },
        new ColumnModel(){ HeaderText= "Done", KeyField=new List<string>() { "Close" } }
    };

    public ObservableCollection<KanbanTask>? TasksCollection { get; set; }
    private string? ToastContent { get; set; }
    private int AddUniqueId { get; set; }
    private int UpdateUniqueId { get; set; }
    private string ToastTarget { get; set; } = "#toast-kanban-observable";

    protected override void OnInitialized()
    {
        var tasks = Enumerable.Range(1, 20).Select(x => new KanbanTask()
        {
            Id = "Task 1000" + x,
            Status = (new string[] { "Open", "In Progress", "Testing", "Close" })[RandomNumberGenerator.GetInt32(4)],
            Summary = (new string[] { "Analyze the new requirements gathered from the customer.", "Improve application performance", "Fix the issues reported in the IE browser.", "Validate new requirements", "Test the application in the IE browser." })[RandomNumberGenerator.GetInt32(5)],
            Assignee = (new string[] { "Nancy Davloio", "Andrew Fuller", "Janet Leverling", "Steven walker", "Margaret hamilt", "Michael Suyama", "Robert King" })[RandomNumberGenerator.GetInt32(7)],
        }).ToList();
        TasksCollection = new ObservableCollection<KanbanTask>(tasks);
    }

    public async Task AddRecord()
    {
        var TaskId = "Task 10000" + ++AddUniqueId;
        this.ToastContent = "<b>Open</b> Column, <b>" + TaskId + "</b> Card has been added";
        await Task.Delay(100);
        TasksCollection?.Add(new KanbanTask() { Id = TaskId, Status = "Open", Summary = "Improve application performance", Assignee = "Janet Leverling" });
        if (this.ToastObj != null)
        {
            await this.ToastObj.ShowAsync();
        }
    }

    public async Task DeleteRecord()
    {
        if (this.ToastObj != null && TasksCollection != null && TasksCollection.Any())
        {
            this.ToastContent = "<b>" + TasksCollection.First().Status + "</b> Column, <b>" + TasksCollection.First().Id + "</b> Card has been deleted";
            await Task.Delay(100);
            TasksCollection.Remove(TasksCollection.First());
            await this.ToastObj.ShowAsync();
        }
    }

    public async Task UpdateRecord()
    {
        if (this.ToastObj != null && TasksCollection != null && TasksCollection.Any())
        {
            var updateId = ++UpdateUniqueId;
            var data = TasksCollection[updateId];
            this.ToastContent = "<b>" + data.Status + "</b> Column, <b>" + data.Id + "</b> Card has been updated";
            await Task.Delay(100);
            data.Summary = "Card Updated";
            data.Status = "Testing";
            await this.ToastObj.ShowAsync();
        }
    }

    public class KanbanTask : INotifyPropertyChanged
    {
        public string? Id { get; set; }
        private string? _status { get; set; }
        public string? Status
        {
            get { return _status; }
            set
            {
                this._status = value;
                NotifyPropertyChanged("Status");
            }
        }
        public string? Summary { get; set; }
        public string? Assignee { get; set; }
        public event PropertyChangedEventHandler? PropertyChanged;
        private void NotifyPropertyChanged(string propertyName)
        {
            var handler = PropertyChanged;
            if (handler != null)
            {
                handler(this, new PropertyChangedEventArgs(propertyName));
            }
        }
    }
}
