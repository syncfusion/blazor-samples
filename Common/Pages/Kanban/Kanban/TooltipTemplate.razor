@page "/kanban/tooltip-template"

@using Syncfusion.Blazor.KanbanDemo
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Kanban
@*Hidden:Lines*@
@inherits SampleBaseComponent;
@*End:Hidden*@

<ActionDescription>
<p>
    This example shows how to customize tooltips that appear when hovering over Kanban cards in the <a class="e-kanban-tooltiptemplate-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component"
                                                                                                                                    href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board"
                                                                                                                                    target="_blank" rel="noopener">Blazor Kanban</a> component by visualizing a  Real Estate Listings. The tooltip reveals assignee, type, estimate, and summary on demand.
</p>
<p>
    The Kanban component provides the following properties for tooltip customization:
</p>
<ul>
    <li>
        <a class="e-kanban-tooltiptemplate-reference-link" aria-label="Navigate to the API reference of EnableTooltip property in Kanban"
           href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.SfKanban-1.html#Syncfusion_Blazor_Kanban_SfKanban_1_EnableTooltip"
           target="_blank" rel="noopener">EnableTooltip</a> – Displays default or templated tooltips based on the <a class="e-kanban-tooltiptemplate-reference-link" aria-label="Navigate to the API reference of TooltipTemplate property in Kanban"
                                                                                                                                    href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.KanbanTemplates.html#Syncfusion_Blazor_Kanban_KanbanTemplates_TooltipTemplate"
                                                                                                                                    target="_blank" rel="noopener">TooltipTemplate</a> setting.
    </li>
    <li>
        <a class="e-kanban-tooltiptemplate-reference-link" aria-label="Navigate to the API reference of TooltipTemplate property in Kanban"
           href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.KanbanTemplates.html#Syncfusion_Blazor_Kanban_KanbanTemplates_TooltipTemplate"
           target="_blank" rel="noopener">TooltipTemplate</a> – Defines custom content for card tooltips when <code>EnableTooltip</code> is true.
    </li>
</ul>
<p>
    Additional essential interactions that enhance analysis and control are also featured:
</p>
<ul>
    <li>
        <a aria-label="Navigate to the documentation for the tooltip template in the kanban component"
           href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.KanbanTemplates.html#Syncfusion_Blazor_Kanban_KanbanTemplates_TooltipTemplate"
           target="_blank" rel="noopener">Tooltip Template</a>: Render a custom layout inside the tooltip using Razor templates.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for the columns in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/columns"
           target="_blank" rel="noopener">Columns</a>: Group cards by workflow stage such as To Do, In Progress, Testing, and Done.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for the toggle tooltip in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/tooltip"
           target="_blank" rel="noopener">Toggle Tooltip</a>: Switch the tooltip on or off from the property panel to compare the behavior.
    </li>
</ul>
<p>
    Key interactive features demonstrated in this sample include:
</p>
<ul>
    <li><b>Hover Tooltip</b>: Hover any card to reveal a custom tooltip with detailed card information.</li>
    <li><b>Rich Content</b>: The tooltip displays the assignee, type, estimate, and summary inside a structured layout.</li>
    <li><b>Toggle Tooltip</b>: Use the property panel switch to turn the tooltip on or off and preview the default experience.</li>
    <li><b>Custom Styling</b>: The tooltip uses dedicated CSS to ensure the content is well structured and easy to scan.</li>
</ul>
<p>
    The <b>Property Panel</b> offers a quick toggle to manage the tooltip behavior:
</p>
<ul>
    <li><b>Enable Tooltip</b>: Turn the templated tooltip on or off for the entire board.</li>
    <li><b>Default vs Custom</b>: When the template is provided, the custom layout is used; otherwise the default tooltip is shown.</li>
</ul>
<p>
Looking for the full Blazor Kanban component overview, features, pricing, and documentation? Visit the <a class="e-kanban-tooltiptemplate-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component" href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board" target="_blank" rel="noopener">Blazor Kanban</a> page.</p>
</ActionDescription>


<div class="col-lg-9 control-section">
    <SfKanban KeyField="Status" DataSource="@CardData" EnableTooltip="@IsEnableTooltip" Height="500px">
        <KanbanColumns>
            @foreach (ColumnModel item in ColumnData)
            {
                <KanbanColumn HeaderText="@item.HeaderText" KeyField="@item.KeyField"/>
            }
        </KanbanColumns>
        <KanbanCardSettings ContentField="Summary" HeaderField="Id"/>
        <KanbanTemplates>
            <TooltipTemplate>
                @{
                    KanbanDataModel card = (KanbanDataModel)context;
                    <div class='e-kanbantooltiptemp'>
                        <table>
                            <tr>
                                <td class="details">
                                    <table>
                                        <colgroup>
                                            <col style="width:30%">
                                            <col style="width:70%">
                                        </colgroup>
                                        <tbody>
                                            <tr>
                                                <td class="CardHeader">Assignee:</td>
                                                <td>@card.Assignee</td>
                                            </tr>
                                            <tr>
                                                <td class="CardHeader">Type:</td>
                                                <td>@card.Type</td>
                                            </tr>
                                            <tr>
                                                <td class="CardHeader">Estimate:</td>
                                                <td>@card.Estimate</td>
                                            </tr>
                                            <tr>
                                                <td class="CardHeader">Summary:</td>
                                                <td>@card.Summary</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                }
            </TooltipTemplate>
        </KanbanTemplates>
    </SfKanban>
</div>
<PropertyPanel ControlSecClass="col-lg-9">
    <table class="property-panel-table" title="Tooltip Template">
        <tbody>
            <tr>
                <td style="width: 100%">
                    <SfCheckBox TChecked="bool" @bind-Checked="@IsEnableTooltip" Label="Enable Tooltip" ValueChange="@((args) => IsEnableTooltip = args.Checked)"></SfCheckBox>
                </td>
            </tr>
        </tbody>
    </table>
</PropertyPanel>

<style>
    .sf-property-panel-section table {
        width: 100%;
    }

    .sf-property-panel-section table tr {
        height: 50px;
    }

    .sf-property-panel-section table td {
        padding-left: 10px;
        width: 50%;
    }

    .sf-property-section .e-icons.e-settings,
    .sf-property-panel-header {
        height: 0;
    }
</style>

@code{
    private bool IsEnableTooltip = true;
    private IReadOnlyCollection<KanbanDataModel> CardData = KanbanDataModel.GetRealEstateListings();

    private List<ColumnModel> ColumnData = new List<ColumnModel>()
    {
        new ColumnModel() { HeaderText = "Coming Soon", KeyField = new List<string>() { "Coming Soon" } },
        new ColumnModel() { HeaderText = "Active", KeyField = new List<string>() { "Active" } },
        new ColumnModel() { HeaderText = "Under Contract", KeyField = new List<string>() { "Under Contract" } },
        new ColumnModel() { HeaderText = "Sold", KeyField = new List<string>() { "Sold" } }
    };
}