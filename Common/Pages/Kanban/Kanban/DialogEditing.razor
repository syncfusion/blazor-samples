@page "/kanban/dialog-editing"

@using Syncfusion.Blazor.KanbanDemo
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Kanban
@*Hidden:Lines*@
@inherits SampleBaseComponent;
@*End:Hidden*@

<ActionDescription>
<p>
    This sample showcases CRUD (Create, Read, Update, Delete) operations in the <a class="e-kanban-dialogediting-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component"
                                                                                                                            href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board"
                                                                                                                            target="_blank" rel="noopener">Blazor Kanban</a> component by visualizing a Veterinary  appointments. Add a new card using the property panel button, and double-click a card to open its details in a dialog for reading, editing, or deleting.
</p>
<p>
    The edit dialog is configured through <a class="e-kanban-dialogediting-reference-link" aria-label="Navigate to the API reference of KanbanDialogSettings"
                                                                                                                            href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.KanbanDialogSettings.html"
                                                                                                                            target="_blank" rel="noopener">KanbanDialogSettings</a>. Double-click any card to open the dialog and perform updates or deletions.
</p>
<p>
    Additional essential interactions that enhance analysis and control are also featured:
</p>
<ul>
    <li>
        <a aria-label="Navigate to the documentation for the dialog editing in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/dialog"
           target="_blank" rel="noopener">Dialog Editing</a>: Open a card in an editor dialog by double-clicking it to update or delete the record.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for the columns in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/columns"
           target="_blank" rel="noopener">Columns</a>: Group cards by workflow stage such as To Do, In Progress, Testing, and Done.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for the add card in the kanban component"
           href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.SfKanban-1.html#Syncfusion_Blazor_Kanban_SfKanban_1_AddCardAsync__0_System_Int32_"
           target="_blank" rel="noopener">Add Card</a>: Add a new card with default values using the property panel button.
    </li>
</ul>
<p>
    Key interactive features demonstrated in this sample include:
</p>
<ul>
    <li><b>Add Card</b>: Use the property panel button to add a new card with default status and metadata.</li>
    <li><b>Edit Card</b>: Double-click any card to open the editor and modify its ID, status, assignee, priority, and summary.</li>
    <li><b>Delete Card</b>: Remove a card directly from the editor dialog using the delete action.</li>
    <li><b>Status Update</b>: Change a card status from the dialog and see it move to the correct column after save.</li>
</ul>
<p>
Looking for the full Blazor Kanban component overview, features, pricing, and documentation? Visit the <a class="e-kanban-dialogediting-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component" href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board" target="_blank" rel="noopener">Blazor Kanban</a> page.</p>
</ActionDescription>


<div class="col-lg-9 control-section">
    <SfKanban @ref="KanbanRef" KeyField="Status" DataSource="@_cardData" Height="500px">
        <KanbanColumns>
            @foreach (ColumnModel item in ColumnData)
            {
                <KanbanColumn HeaderText="@item.HeaderText" KeyField="@item.KeyField"/>
            }
        </KanbanColumns>
        <KanbanCardSettings HeaderField="Id" ContentField="Summary">
                     <Template>
                @{
                    KanbanDataModel card = (KanbanDataModel)context;
                    <div class="dialog-card" style="border-left-color: @card.Color;">
                        <div class="dc-header">
                            <span class="dc-id">@card.Id</span>
                            <span class="dc-priority" data-priority="@card.Priority">
                                <span class="dc-priority-dot"></span>
                                @card.Priority
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(card.Title))
                        {
                            <div class="dc-title">@card.Title</div>
                        }
                        <div class="dc-content">@card.Summary</div>
                        <div class="dc-tags">
                            @if (card.CardTags != null)
                            {
                                @foreach (string tag in card.CardTags)
                                {
                                    <span class="dc-tag">@tag</span>
                                }
                            }
                        </div>
                        <div class="dc-footer">
                            <div class="dc-type">
                                <span class="dc-type-icon"></span>
                                <span>@card.Type</span>
                            </div>
                            <div class="dc-assignee">
                                <span class="dc-avatar" style="background: @card.Color;">
                                    @GetInitials(card.Assignee)
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </Template>
        </KanbanCardSettings>
        <KanbanDialogSettings>
            <Template>
                @{
                    var data = (KanbanDataModel)context;
                    <table>
                        <tbody>
                            <tr>
                                <td class="e-label">ID</td>
                                <td>
                                    <SfTextBox CssClass="e-field" Value="@data.Id" Enabled="false"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="e-label">Status</td>
                                <td>
                                    <SfDropDownList @ref="StatusRef" TValue="string" TItem="DropDownModel" CssClass="e-field" DataSource="@StatusData" @bind-Value="@data.Status">
                                        <DropDownListFieldSettings Text="Value" Value="Value"/>
                                    </SfDropDownList>
                                </td>
                            </tr>
                            <tr>
                                <td class="e-label">Assignee</td>
                                <td>
                                    <SfDropDownList @ref="AssigneeRef" TValue="string" TItem="DropDownModel" CssClass="e-field" DataSource="@AssigneeData" @bind-Value="@data.Assignee">
                                        <DropDownListFieldSettings Text="Value" Value="Value"/>
                                    </SfDropDownList>
                                </td>
                            </tr>
                            <tr>
                                <td class="e-label">Priority</td>
                                <td>
                                    <SfDropDownList @ref="PriorityRef" TValue="string" TItem="DropDownModel" CssClass="e-field" DataSource="@PriorityData" @bind-Value="@data.Priority">
                                        <DropDownListFieldSettings Text="Value" Value="Value"/>
                                    </SfDropDownList>
                                </td>
                            </tr>
                            <tr>
                                <td class="e-label">Summary</td>
                                <td>
                                    <SfTextBox @ref="SummaryRef" CssClass="e-field" Multiline="true" @bind-Value="@data.Summary"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
            </Template>
        </KanbanDialogSettings>
    </SfKanban>
</div>
<PropertyPanel ControlSecClass="col-lg-9">
    <table class="property-panel-table" title="Add Card">
        <tbody>
            <tr>
                <td>
                    <SfButton Content="Add New Card" OnClick="ShowAddCardDialog"/>
                </td>
            </tr>
        </tbody>
    </table>
</PropertyPanel>

