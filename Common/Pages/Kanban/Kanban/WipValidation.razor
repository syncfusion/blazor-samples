@page "/kanban/wip-validation"

@using Syncfusion.Blazor.KanbanDemo
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Kanban
@*Hidden:Lines*@
@inherits SampleBaseComponent;
@*End:Hidden*@

<ActionDescription>
<p>
    This sample demonstrates how to limit the minimum and maximum number of cards per column in the <a class="e-kanban-wipvalidation-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component"
                                                                                                                                href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board"
                                                                                                                                target="_blank" rel="noopener">Blazor Kanban</a> component by visualizing a Runway Slots. Use the property panel to choose the constraint type and configure related attributes such as minimum and maximum card counts.
</p>
<p>
    Validate the number of cards at the column or swimlane level using the <a class="e-kanban-wipvalidation-reference-link" aria-label="Navigate to the API reference of ConstraintType property in Kanban"
                                                                                                                                href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.SfKanban-1.html#Syncfusion_Blazor_Kanban_SfKanban_1_ConstraintType"
                                                                                                                                target="_blank" rel="noopener">ConstraintType</a> property:
</p>
<ul>
    <li><a class="e-kanban-wipvalidation-reference-link" aria-label="Navigate to the API reference of Column property in Kanban"
           href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.ConstraintType.html#Syncfusion_Blazor_Kanban_ConstraintType_Column"
           target="_blank" rel="noopener">Column</a> – Validates based on the total cards in a column (default).</li>
    <li><a class="e-kanban-wipvalidation-reference-link" aria-label="Navigate to the API reference of Swimlane property in Kanban"
           href="https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Kanban.ConstraintType.html#Syncfusion_Blazor_Kanban_ConstraintType_Swimlane"
           target="_blank" rel="noopener">Swimlane</a> – Validates based on cards within a specific column and swimlane.
    </li>
</ul>
<p>
    Additional essential interactions that enhance analysis and control are also featured:
</p>
<ul>
    <li>
        <a aria-label="Navigate to the documentation for the WIP validation in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/validation"
           target="_blank" rel="noopener">WIP Validation</a>: Enforce minimum and maximum card counts per column or per swimlane to balance workload.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for the swimlane in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/swimlane"
           target="_blank" rel="noopener">Swimlane</a>: Group cards horizontally by assignee to apply WIP limits per team member.
    </li>
    <li>
        <a aria-label="Navigate to the documentation for the columns in the kanban component"
           href="https://blazor.syncfusion.com/documentation/kanban/columns"
           target="_blank" rel="noopener">Columns</a>: Group cards by workflow stage such as To Do, In Progress, Testing, and Done.
    </li>
</ul>
<p>
    Key interactive features demonstrated in this sample include:
</p>
<ul>
    <li><b>Constraint Type</b>: Switch the validation scope between Column and Swimlane using the dropdown in the property panel.</li>
    <li><b>Column Selection</b>: Pick a column from the dropdown to set its minimum and maximum card limits.</li>
    <li><b>Min Count</b>: Define the minimum number of cards that must be present in the selected column.</li>
    <li><b>Max Count</b>: Define the maximum number of cards allowed in the selected column.</li>
    <li><b>Validation State</b>: When limits are not met or are exceeded, the column renders a validation state for visual feedback.</li>
</ul>
<p>
Looking for the full Blazor Kanban component overview, features, pricing, and documentation? Visit the <a class="e-kanban-wipvalidation-reference-link" aria-label="Navigate to the explore Syncfusion Blazor Kanban component" href="https://www.syncfusion.com/gantt-sdk/blazor-kanban-board" target="_blank" rel="noopener">Blazor Kanban</a> page.</p>
</ActionDescription>


<div class="col-lg-9 control-section">
    <SfKanban KeyField="Status" DataSource="@_cardData" Height="500px" ConstraintType="@(IsSwimlaneEnable? ConstraintType.Swimlane: ConstraintType.Column)">
        <KanbanColumns>
            @foreach (ColumnModel item in _columnData)
            {
                <KanbanColumn HeaderText="@item.HeaderText" KeyField="@item.KeyField" AllowToggle="true" ShowItemCount="true" 
                            MinCount="@item.MinCount" MaxCount="@item.MaxCount"/>
            }
        </KanbanColumns>
        <KanbanCardSettings HeaderField="Id" ContentField="Summary">
        <Template>
            @{
                KanbanDataModel card = (KanbanDataModel)context;
                <div class="min-card" style="--color: @card.Color;">
                    <div class="mc-strip"></div>
                    <div class="mc-content">
                        <div class="mc-head">
                            <span class="mc-type">@card.Type</span>
                            <span class="mc-avatar">@GetInitials(card.Assignee)</span>
                        </div>
                        <h3 class="mc-title">@card.Title</h3>
                        <p class="mc-desc">@card.Summary</p>
                        <div class="mc-footer">
                            <span class="mc-priority" data-p="@card.Priority">@card.Priority</span>
                            <span class="mc-id">@card.Id</span>
                        </div>
                    </div>
                </div>
            }
        </Template>
    </KanbanCardSettings>

        <KanbanSwimlaneSettings KeyField="Assignee" ShowItemCount="true" AllowDragAndDrop="true"/>
    </SfKanban>
</div>
<PropertyPanel ControlSecClass="col-lg-9">
    <div class="property-panel-header">Constraint</div>
        <table class="property-panel-table" title="Constraint">
            <tbody>
                <tr>
                    <td style="width: 35%">Type</td>
                    <td style="width: 65%">
                        <SfDropDownList TItem="string" TValue="string" DataSource="@ColumnConstraints" @bind-Value="@ColumnConstraintValue">
                            <DropDownListEvents TItem="string" TValue="string" ValueChange="@((args) => IsSwimlaneEnable = args.Value == "Swimlane")"/>
                        </SfDropDownList>
                    </td>
                </tr>
            </tbody>
        </table>
    <div class="property-panel-header">Validate Constraints</div>
        <table class="property-panel-table" title="Validate Constraints">
            <tbody>
                <tr>
                    <td style="width: 35%">Columns</td>
                    <td style="width: 65%">
                        <SfDropDownList TItem="string" TValue="string" DataSource="@KanbanColumns" Placeholder="Header Text" ShowClearButton="true" 
                                        @bind-Value="@ColumnKeyValue">
                            <DropDownListFieldSettings Text="HeaderText" Value="KeyField"/>
                            <DropDownListEvents TItem="string" TValue="string" ValueChange="ColumnValueUpdate"/>
                        </SfDropDownList>
                    </td>
                </tr>
                <tr>
                    <td style="width: 35%">MinCount</td>
                    <td style="width: 65%">
                        <SfNumericTextBox ID="minIndex" TValue="int?" Placeholder="Minimum Count" Min="0" Max="20" @bind-Value=@ColumnMinCount/>
                    </td>
                </tr>
                <tr>
                    <td style="width: 35%">MaxCount</td>
                    <td style="width: 65%">
                        <SfNumericTextBox ID="maxIndex" TValue="int?" Placeholder="Maximum Count" Min="0" Max="20" @bind-Value=@ColumnMaxCount/>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">
                        <SfButton ID="validate" Content="Validate" OnClick="OnColumnValidationUpdate"/>
                    </td>
                </tr>
            </tfoot>
        </table>
</PropertyPanel>

