@code{
    private IReadOnlyCollection<KanbanDataModel> CardData = KanbanDataModel.GetCoffeeRoasteryBatches();
    private List<ColumnModel> ColumnData = new List<ColumnModel>() 
    {
        new ColumnModel(){ HeaderText= "Green Bean", KeyField= new List<string>() { "Green Bean" } },
        new ColumnModel(){ HeaderText= "Roasting", KeyField= new List<string>() { "Roasting" } },
        new ColumnModel(){ HeaderText= "Cooling", KeyField= new List<string>() { "Cooling" } },
        new ColumnModel(){ HeaderText= "Packaging", KeyField=new List<string>() { "Packaging" } }
    };

    private string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }
}