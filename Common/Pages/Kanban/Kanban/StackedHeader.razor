@code{
    
    private IReadOnlyCollection<KanbanDataModel> CardData = KanbanDataModel.GetAssemblyLineTasks();
    private List<ColumnModel> ColumnData = new List<ColumnModel>() 
    {
        new ColumnModel(){ HeaderText= "Frame Welding", KeyField= new List<string>() { "Frame Welding" } },
        new ColumnModel(){ HeaderText= "Painting", KeyField= new List<string>() { "Painting" } },
        new ColumnModel(){ HeaderText= "Assembly", KeyField= new List<string>() { "Assembly" } },
        new ColumnModel() { HeaderText = "QA", KeyField = new List<string>() { "QA" } }
    };

    private List<StackedHeaderModel> StackedHeaderData = new List<StackedHeaderModel>() 
    {
        new StackedHeaderModel(){ Text= "Preparation", KeyFields= new List<string>() { "Frame Welding" } },
        new StackedHeaderModel(){ Text= "Build Phase", KeyFields= new List<string>() { "Painting", "Assembly" } },
        new StackedHeaderModel(){ Text= "Completion", KeyFields= new List<string>() { "QA" } }
    };
    private string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }
}