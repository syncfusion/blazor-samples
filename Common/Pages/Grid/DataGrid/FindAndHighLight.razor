@page "/datagrid/find-and-highlight"

@using Syncfusion.Blazor.Grids
@*Hidden:Lines*@
@inherits SampleBaseComponent
@inject NavigationManager NavigationManager

@*End:Hidden*@

<ActionDescription>
    <p>
        This sample demonstrates the DataGrid built-in <strong>find and highlight</strong> feature, which enables quick searching and navigation of data within the grid. Matching values are highlighted in real time, making it easier to locate information in large datasets.
    </p>

    <p>
        Enter a search term in the built-in search box to find matching text, numbers, or partial values. Use the navigation buttons in the toolbar to move between search results without manually scanning rows and columns.
    </p>

    <p>Key features demonstrated in this sample include:</p>

    <ul>
        <li>Search across grid data using text, numbers, or partial values.</li>
        <li>Highlight all matching occurrences in real time.</li>
        <li>Navigate between matches using toolbar navigation controls.</li>
        <li>Use <strong>Enter</strong> to move to the next match and <strong>Shift + Enter</strong> to move to the previous match.</li>
        <li>
            Customize the find experience through the <a target='_blank' href='https://help.syncfusion.com/cr/blazor/Syncfusion.Blazor.Grids.GridFindSettings.html' aria-label="Navigate to the documentation for GridFindSettings" rel="noopener">GridFindSettings</a>
            component, including properties such as <code>Placeholder</code> for search input guidance.
        </li>
    </ul>

    <p>
        The find functionality is enabled through the grid's <a target='_blank' href='https://help.syncfusion.com/grid-sdk/blazor/data-grid/toolbar-items' aria-label="Navigate to the documentation for toolbar" rel="noopener">Toolbar</a> property, providing a convenient way to search and review records within large datasets.
    </p>

    <p>
        This feature is useful in applications such as customer management, inventory tracking, support ticket systems, and other data-intensive scenarios that require fast access to specific information.
    </p>
<p>For more detailed information about the find and highlight feature, refer to the <a target='_blank' href='https://help.syncfusion.com/grid-sdk/blazor/data-grid/searching' aria-label="Navigate to the documentation for find and highlight in DataGrid component" rel="noopener">find and highlight documentation</a>.</p>

<p>Looking for the full Blazor DataGrid component overview, features, pricing, and documentation? Visit our <a rel="noopener" target='_blank' href='https://www.syncfusion.com/blazor-components/blazor-datagrid' aria-label="Navigate to the Blazor DataGrid FT page">Blazor DataGrid component</a> page.</p>
</ActionDescription>


<div class="col-lg-12 control-section">
    <div class="content-wrapper">
        <div class="row">

            <SfGrid DataSource="@GridData"
                                AllowSorting="true"
                                Height="500" AllowTextWrap="true" AllowReordering="true"
                                FrozenColumns="1" AllowFiltering="true" Toolbar="@(new List<string> { "Find" })">
                <GridFindSettings PlaceholderText="Find in tickets..." ></GridFindSettings>
                <GridFilterSettings Type="FilterType.Menu"></GridFilterSettings>
                <GridColumns>

                    <GridColumn Field=@nameof(SupportTicket.TicketId)
                                HeaderText="Ticket ID"
                                Width="130"
                                IsPrimaryKey="true">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.Subject)
                                HeaderText="Subject"
                                Width="250">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.CustomerName)
                                HeaderText="Customer Name"
                                Width="180">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.Email)
                                HeaderText="Email"
                                Width="220">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.ContactNumber)
                                HeaderText="Contact Number"
                                Width="180">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.Priority)
                                HeaderText="Priority"
                                Width="120">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.Status)
                                HeaderText="Status"
                                Width="120">
                    <GridColumn Field=@nameof(SupportTicket.Category)
                                HeaderText="Category"
                                Width="130">
                    </GridColumn>
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.AssignedTo)
                                HeaderText="Assigned To"
                                Width="180">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.CreatedDate)
                                HeaderText="Created Date"
                                Width="140"
                                Type="ColumnType.Date"
                                Format="d">
                    </GridColumn>

                    <GridColumn Field=@nameof(SupportTicket.LastUpdated)
                                HeaderText="Last Updated"
                                Width="140"
                                Type="ColumnType.Date"
                                Format="d">
                    </GridColumn>
                    <GridColumn Field=@nameof(SupportTicket.Description)
                                HeaderText="Description"
                                Width="350">
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
</div>

@code {
    public List<SupportTicket> GridData { get; set; } = new();

    protected override void OnInitialized()
    {
        GridData = SupportTicket.GetAllRecords().ToList();
    }
}


