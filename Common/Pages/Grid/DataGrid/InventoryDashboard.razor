        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .ig-status--ok {
        background: #d1fae5;
        color: #059669;
    }

    .ig-status--low {
        background: #fee2e2;
        color: #dc2626;
    }

    .ig-status--out {
        background: #f3f4f6;
        color: #6b7280;
    }

