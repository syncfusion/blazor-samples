            font-size: 18px;
            line-height: 1;
            color: #ce67ce !important;
        }

    .ig-dcard__avatar--blue {
        background: #dbeafe;
        color: #3b82f6;
    }

        .ig-dcard__avatar--blue .e-description {
            color: #3b82f6 !important;
        }

    .ig-dcard__avatar--green {
        background: #d1fae5;
        color: #10b981;
    }

    .ig-dcard__avatar--purple {
        background: #ede9fe;
        color: #FFF291;
    }

    .ig-dcard__title {
        font-size: 16px;
