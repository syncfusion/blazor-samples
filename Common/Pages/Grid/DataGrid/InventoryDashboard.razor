    }

    .ig-dcard__discount {
        color: #ef4444;
    }

    .ig-dcard__profit {
        color: #22c55e;
    }

    .ig-status-cell {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
    }

    .ig-status__sub {
        display: block;
        text-align: center;
        font-size: 12px;
        color: var(--ig-text-muted);
    }

