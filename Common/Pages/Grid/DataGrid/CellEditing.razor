@code {
    private List<AppointmentData>? GridData { get; set; }
    private bool AllowEditOnKeyPress { get; set; } = true;
    private EnterKeyDirection SelectedEnterDirection { get; set; } = EnterKeyDirection.NextRow;
    private List<DropdownOption<EnterKeyDirection>> EnterDirectionOptions { get; set; } = new List<DropdownOption<EnterKeyDirection>>
    {
        new DropdownOption<EnterKeyDirection> { Label = "None", Value = EnterKeyDirection.None },
        new DropdownOption<EnterKeyDirection> { Label = "NextRow", Value = EnterKeyDirection.NextRow },
        new DropdownOption<EnterKeyDirection> { Label = "NextColumn", Value = EnterKeyDirection.NextColumn }
    };
    private List<DoctorItem> DoctorItems { get; set; } = new List<DoctorItem>()
    {
        new DoctorItem() { DoctorName = "Dr. Martinez" },
        new DoctorItem() { DoctorName = "Dr. Smith" },
        new DoctorItem() { DoctorName = "Dr. Garcia" },
        new DoctorItem() { DoctorName = "Dr. Brianna" },
        new DoctorItem() { DoctorName = "Dr. Davis" },
        new DoctorItem() { DoctorName = "Dr. Johnson" },
        new DoctorItem() { DoctorName = "Dr. Williams" }
    };

    private List<TypeItem> TypeList { get; set; } = new List<TypeItem>()
    {
        new TypeItem() { TypeValue = "Consultation", TypeText = "Consultation" },
        new TypeItem() { TypeValue = "FollowUp", TypeText = "FollowUp" },
        new TypeItem() { TypeValue = "LabTest", TypeText = "LabTest" },
        new TypeItem() { TypeValue = "Emergency", TypeText = "Emergency" },
        new TypeItem() { TypeValue = "RoutineCheck", TypeText = "RoutineCheck" }
    };

    private List<StatusItem> StatusList { get; set; } = new List<StatusItem>()
    {
        new StatusItem() { Value = "Booked", Text = "Booked" },
        new StatusItem() { Value = "Pending", Text = "Pending" },
        new StatusItem() { Value = "Completed", Text = "Completed" },
        new StatusItem() { Value = "Canceled", Text = "Canceled" }
    };
    protected override void OnInitialized()
    {
        GridData = AppointmentData.GetAppointmentData().ToList();
    }
    public void ActionBeginHandler(ActionEventArgs<AppointmentData> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save && args.Action == "Add")
        {
            if (args.Data != null)
            {
                args.Data.AppointmentID = (int)(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() % 100000);
            }
        }
    }
    private string GetDoctorImageId(string doctorName)
    {
        return doctorName switch
        {
            "Dr. Martinez" => "1",
            "Dr. Smith" => "2",
            "Dr. Garcia" => "3",
            "Dr. Brianna" => "4",
            "Dr. Davis" => "5",
            "Dr. Johnson" => "6",
            "Dr. Williams" => "7",
            _ => "1"
        };
    }
    private string GetTypeClass(AppointmentType type)
    {
        return type switch
        {
            AppointmentType.Consultation => "consultation",
            AppointmentType.FollowUp => "followup",
            AppointmentType.LabTest => "labtest",
            AppointmentType.Emergency => "emergency",
            AppointmentType.RoutineCheck => "routinecheck",
            _ => "default"
        };
    }
    private string GetTypeDisplay(AppointmentType type)
    {
        return type switch
        {
            AppointmentType.Consultation => "Consultation",
            AppointmentType.FollowUp => "Follow-up",
            AppointmentType.LabTest => "Lab Test",
            AppointmentType.Emergency => "Emergency",
            AppointmentType.RoutineCheck => "Routine Check",
            _ => type.ToString()
        };
    }
    private string GetStatusClass(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Booked => "booked",
            AppointmentStatus.Pending => "pending",
            AppointmentStatus.Completed => "completed",
            AppointmentStatus.Canceled => "canceled",
            _ => "default"
        };
    }
    private class DropdownOption<T>
    {
        public string? Label { get; set; }
        public T? Value { get; set; }
    }

    public class DoctorItem
    {
        public string? DoctorName { get; set; }
    }

    public class TypeItem
    {
        public string? TypeValue { get; set; }
        public string? TypeText { get; set; }
    }

    public class StatusItem
    {
        public string? Value { get; set; }
        public string? Text { get; set; }
    }
}
