@namespace BlazorDemos.Shared

@inject IJSRuntime JsRuntime;

<div class="sf-dropdown-container">
    <div class="sf-dropdown-input-container" @onclick="@OnInputClick" @onkeydown="OnInputKeyDown" @onclick:stopPropagation="true">
        <input @ref="inputElement" @bind="Value" class="sf-dropdown-input" aria-label="Culture Switcher" readonly="readonly" tabindex="0"/>
        <span class="sb-icons sf-dropdown-icon" role="presentation"></span>
    </div>
    <div class="@popupClass">
        <ul class="@SampleUtils.ListUlClass">
            @foreach (var item in DataSource ?? new List<DropDownData>())
            {
                var liClass = SampleUtils.ListLiClass;
                if (item.Text == Value)
                {
                    liClass = SampleUtils.AddClass(liClass, SampleUtils.ActiveClass);
                }
                <li class="@liClass" @onclick="@(async () => { await OnItemSelect(item); })" @onkeydown="@((e) => OnItemKeySelect(item, e))" tabindex="0">
                    @if (ItemTemplate != null)
                    {
                        @ItemTemplate(item);
                    }
                    else
                    {
                        <span>@item.Text</span>
                    }
                </li>
            }
        </ul>
        @if (ShowThemeStudioLink && DefaultValue == "CHOOSE THEME")
        {
            <div class="sb-theme-studio">
                <a target='_blank' href="https://blazor.syncfusion.com/themestudio/?theme=material" aria-label="Go to Theme Studio">Go to Theme Studio</a>
            </div>
        }
    </div>
</div>

@code {
    public string? popupClass { get; set; }
    private ElementReference inputElement { get; set; }
    public bool isthemepopupopen { get; set; }
    public bool isdemopopupopen { get; set; }
    public bool issampledemopopup { get; set; }
    public bool issdkswitcherpopupopen { get; set; }

    /// <summary>
    /// ChildContent of DropDownComponent.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Specifies the DataSource of DropDown component.
    /// </summary>
    [Parameter]
    public List<DropDownData>? DataSource { get; set; }

    /// <summary>
    /// Specifies the value to be set in the input element.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Specifies the static default value to the input element.
    /// </summary>
    [Parameter]
    public string? DefaultValue { get; set; }

    /// <summary>
    /// Specifies whether to show the "Go to Theme Studio" link.
    /// </summary>
    [Parameter]
    public bool ShowThemeStudioLink { get; set; } = true;

    /// <summary>
    /// Specifies the custom item template to be render in the list element.
    /// </summary>
    [Parameter]
    public RenderFragment<DropDownData>? ItemTemplate { get; set; }

    /// <summary>
    /// Triggers the event on item selection.
    /// </summary>
    [Parameter]
    public EventCallback<DropDownData> OnSelect { get; set; }

    /// <summary>
    /// Specifies the type of dropdown (Theme, Demo, or SDKSwitcher).
    /// </summary>
    [Parameter]
    public string? DropdownType { get; set; }

    /// <summary>
    /// Specifies the selected item ID used to highlight the active item in the popup list.
    /// </summary>
    [Parameter]
    public string? SelectedID { get; set; }

    /// <summary>
    /// Triggers the event on item selection.
    /// </summary>
    [Parameter]
    public EventCallback<(DropDownData, KeyboardEventArgs)> OnKeyItem { get; set; }

    /// <summary>
    /// Triggers when the dropdown popup opens.
    /// </summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    // Input container click event handler.
    private async Task OnInputClick()
    {
        if (popupClass != null && popupClass.Contains(BlazorDemos.Shared.SampleUtils.DisplayNone))
        {
            popupClass = SampleUtils.RemoveClass(popupClass, SampleUtils.DisplayNone);
            // Only set the specific flag for this dropdown type
            if (DropdownType == "Theme")
            {
                isthemepopupopen = true;
            }
            else if (DropdownType == "Demo")
            {
                isdemopopupopen = true;
                issampledemopopup = true;
            }
            else if (DropdownType == "SDKSwitcher")
            {
                issdkswitcherpopupopen = true;
            }
            if (OnOpen.HasDelegate)
            {
                await OnOpen.InvokeAsync();
            }
        }
        else
        {
            popupClass = SampleUtils.AddClass(popupClass ?? "", SampleUtils.DisplayNone);
            // Reset the specific flag when closing
            if (DropdownType == "Theme")
            {
                isthemepopupopen = false;
            }
            else if (DropdownType == "Demo")
            {
                isdemopopupopen = false;
                issampledemopopup = false;
            }
            else if (DropdownType == "SDKSwitcher")
            {
                issdkswitcherpopupopen = false;
            }
        }
    }

    private async void OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnInputClick();
        }
    }

    // Icon click event handler.
    private async Task OnIconClick()
    {
        await JsRuntime.InvokeVoidAsync("sfBlazorSB.inputFocus", inputElement);
    }

    // Input blur event handler.
    private async Task OnInputBlur()
    {
        // Await the popup hide process for dropdown selection.
        await Task.Delay(200);
        popupClass = SampleUtils.AddClass(popupClass ?? "", SampleUtils.DisplayNone);
    }

    // Item selection event handler.
    private async Task OnItemSelect(DropDownData args)
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(args);
        }
    }

    // Item selection using keyboard event handler.
    private async Task OnItemKeySelect(DropDownData args, KeyboardEventArgs e)
    {
        if (OnKeyItem.HasDelegate)
        {
            await OnKeyItem.InvokeAsync((args, e));
        }
    }

    /// <summary>
    /// Hide the dropdown popup.
    /// </summary>
    public async Task HideList()
    {
        popupClass = SampleUtils.AddClass(popupClass ?? "", SampleUtils.DisplayNone);
        // Reset the specific flag when hiding
        if (DropdownType == "Theme")
        {
            isthemepopupopen = false;
        }
        else if (DropdownType == "Demo")
        {
            isdemopopupopen = false;
            issampledemopopup = false;
        }
        else if (DropdownType == "SDKSwitcher")
        {
            issdkswitcherpopupopen = false;
        }
        await Task.CompletedTask;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Value == null && DataSource != null && DataSource.Any())
        {
            Value = DataSource.First().Text;
        }
        popupClass = SampleUtils.DropDownPopup + SampleUtils.Space + SampleUtils.DisplayNone;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (DefaultValue != null)
        {
            Value = DefaultValue;
        }
    }

    /// <summary>
    /// Re-rendering the component to notify it's state has been changed.
    /// </summary>
    internal void Refresh()
    {
        StateHasChanged();
    }
}
