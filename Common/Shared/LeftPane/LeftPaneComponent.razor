@namespace BlazorDemos.Shared

@inject IJSRuntime JsRuntime;
@inject NavigationManager UriHelper;
@inherits SampleBaseComponent;

<SideBarComponent Position="SidebarPlacement.Left" IsExpanded="@isOpen">
    <div class='sb-left-pane e-view'>
        <div class='sb-left-header'>
            <div class='sb-left-header-item sb-table-cell' id="sb-left-header-text" aria-label="Sample Header icon" title="Navigates to Home page" @onclick="HomeIconClick" @onkeydown="OnHomeIconKeyDown" role="button" style="width:auto">
                <span tabindex="0" class="sb-icons sb-icon-Home icon-home"></span>
            </div>
            <div class='sb-left-header-item sb-table-cell' id="sb-left-header-text" aria-label="Sample Header Text" title="Navigates to Home page" @onclick="HomeIconClick" @onkeydown="OnHomeIconKeyDown"  role="button" >
                <span tabindex="0" class="sb-header-content">@SampleService?.DemoType</span>
            </div>
            <div class='sb-left-header-item sb-table-cell'>
                <div id="sb-toggle-left" @onclick="OnToggleClick" @onkeydown="OnToggleKeyDown" @onclick:stopPropagation="true" role="button" tabindex="0" class="sb-slide-nav sb-icons toggle-active sb-icon-screenshot" aria-label="toggle all controls navigation"
                    title='toggle leftpane'>
                    <svg viewBox="0 0 24 24" width="22" height="22" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="4" width="16" height="14" rx="1" ry="1"/>
                        <line x1="4" y1="9" x2="20" y2="9"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
        <div class='sb-control-navigation e-view'>
            <NavMenuComponent @ref="NavMenuRef"></NavMenuComponent>
        </div>
        @if (SampleService!.IsDevice)
        {
            <div class='sb-left-footer'>
                <div class="sb-mobile-header-buttons">
                    <a href='https://www.syncfusion.com/blazor-components' target="_blank" rel="noopener" aria-label="About">
                        <div class="sb-mobile-header-about">
                            About
                        </div>
                    </a>
                    <a href='https://www.syncfusion.com/downloads/blazor' target="_blank" rel="noopener" aria-label="Pricing">
                        <div class="sb-mobile-header-price">Pricing</div>
                    </a>
                </div>
                <div class='sb-left-footer-links'></div>
            </div>
        }
</SideBarComponent>

@if (SampleService!.IsDevice)
{
    <style>
        .sb-mobile-logo {
            background: url(@(SampleService?.ImagePath + "syncfusion-mobile-logo.svg")) no-repeat;
        }
    </style>
}

@code {

    private bool isOpen { get; set; }

    /// <summary>
    /// NavMenuComponent reference for outside usage.
    /// </summary>
    public NavMenuComponent? NavMenuRef { get; set; }

    /// <summary>
    /// Expand or collapse SideBarComonent based on its previous state.
    /// </summary>

    /// <summary>
    /// DropdownComponent reference for outside usage.
    /// </summary>
    public DropDownComponent? dropdownRef { get; set; }

        /// <summary>
    /// Triggers event callback on left toggle button action.
    /// </summary>
    [Parameter]
    public EventCallback OnToggleClick { get; set; }

    /// <summary>
    /// Triggers event callback on home icon button click action.
    /// </summary>
    [Parameter]
    public EventCallback HomeIconClick { get; set; }

    private void OnToggleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            OnToggleClick.InvokeAsync();
        }
    }

    private void OnHomeIconKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HomeIconClick.InvokeAsync();
        }
    }

    public void UpdateExpandedState()
    {
       SetExpanded(!isOpen);
    }

    /// <summary>
    /// Explicitly set expanded state of the left pane.
    /// </summary>
    public void SetExpanded(bool expanded)
    {
        this.isOpen = expanded;
        JsRuntime.InvokeVoidAsync("ScrollToSelected");
        StateHasChanged();
    }

    /// <summary>
    /// Returns bool value for expanded state of the component.
    /// </summary>
    public bool IsExpanded()
    {
        return isOpen;
    }

    // Home button click handler
    public async Task HomeButtonClick()
    {
        // Set default values to SampleService for home page navigation.
        SampleService!.ComponentName = null;
        SampleService!.CurrentSamplePath = null;
        SampleService!.SampleInfo = null;
        UriHelper.NavigateTo(UriHelper.BaseUri, true);
        var themeName = SampleUtils.GetThemeName(UriHelper.Uri);
        await JsRuntime.InvokeVoidAsync("sfBlazorSB.updateBodyClass", themeName);
    }

    private async void OnHomeButtonKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HomeButtonClick();
        }
    }

    private void OnDemoSwitch(DropDownData args)
    {
        if (args != null && args.ID != null && UriHelper != null && UriHelper.BaseUri != null && !UriHelper.BaseUri.Contains("localhost"))
        {
            if (SampleService!.SampleInfo!.Directory!.Contains("AISamples"))
            {
                SampleService.SwicthToDemo(args?.ID ?? "", UriHelper, true, JsRuntime);
            }
            else
            {
                SampleService.SwicthToDemo(args.ID, UriHelper, false, JsRuntime);

            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.isOpen = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            // Collapse the SideBarComponent for device rendering.
            if (SampleService!.IsDevice)
            {
                this.isOpen = !SampleService.IsDevice;
                StateHasChanged();
            }
        }
    }
}
